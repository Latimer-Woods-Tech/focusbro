<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive-icon background layer: the site's .logo-icon gradient,
     135deg from the primary (#0ea5e9) to the teal (#14b8a6) token. Full-bleed 108dp;
     the launcher applies its own mask shape. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:offset="0" android:color="#FF0EA5E9" />
                <item android:offset="1" android:color="#FF14B8A6" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
