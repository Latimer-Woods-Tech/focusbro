<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and higher (dataExtractionRules): excluded from cloud backup AND device-to-device transfer (spec r4 §4, AL-P2/P4). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="focuslock.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="focuslock.xml" />
    </device-transfer>
</data-extraction-rules>
